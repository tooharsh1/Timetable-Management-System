# Supabase project values. The anon/publishable key is browser-safe; never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server-only values. Use a long random value for SOLVER_API_KEY.
SOLVER_API_KEY=replace-with-a-long-random-secret
# Local `pnpm dev` can point at an API running on the host. Docker Compose overrides this to its internal service name.
SOLVER_API_URL=http://127.0.0.1:8000
REDIS_URL=redis://127.0.0.1:6379/0
WEB_PORT=3000
